APP_NAME=KB Market Survey
APP_ENV=production
APP_TIMEZONE=Asia/Phnom_Penh

# Railway: set this to a reference variable:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=

KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_TOKEN=
KOBO_ASSET_UID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dealer submit-count alerts. Run /alert_submit once inside the target General
# group to save it automatically, or set SUBMIT_ALERT_CHAT_ID here/Railway.
SUBMIT_ALERT_ENABLED=true
SUBMIT_ALERT_CHAT_ID=
# Leave empty or 0 to post in the forum General topic.
SUBMIT_ALERT_THREAD_ID=
SUBMIT_ALERT_FIRST_TIME=09:30
SUBMIT_ALERT_FIRST_THRESHOLD=10
SUBMIT_ALERT_SECOND_TIME=10:30
SUBMIT_ALERT_SECOND_THRESHOLD=20
SUBMIT_ALERT_GRACE_MINUTES=30

TEMPLATE_PATH=templates/template_by_dealer.xlsx
EXPORT_DIR=exports

AUTO_SYNC_BEFORE_REPORT=false
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=60
REPORT_SYNC_WAIT_SECONDS=240

# Docker/Linux path. The code also auto-detects LibreOffice.
LIBREOFFICE_PATH=/usr/bin/libreoffice

PNG_RENDER_SCALE=4.0
PNG_MAX_WIDTH=6000
