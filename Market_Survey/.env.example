APP_NAME=KB Market Survey
APP_ENV=production
APP_TIMEZONE=Asia/Phnom_Penh

# Railway: set this to a reference variable:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=

KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_TOKEN=replace_with_kobo_api_token
KOBO_ASSET_UID=replace_with_kobo_asset_uid

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=

# Railway public HTTPS domain. Enter only the URL value, without
# "PUBLIC_APP_URL=" inside the value.
PUBLIC_APP_URL=https://marketsurvey-production.up.railway.app
MAP_PUBLIC_VIEW_ENABLED=true
MAP_VIEWER_TOKEN=replace_with_64_character_random_token
MAP_EDITOR_TOKEN=replace_with_a_different_64_character_random_token
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
REVERSE_GEOCODING_TIMEOUT_SECONDS=5

TEMPLATE_PATH=templates/template_by_dealer.xlsx
HORECA_TEMPLATE_PATH=templates/template_horeca_products.xlsx
GT_SUMMARY_TEMPLATE_PATH=templates/template_gt_summary.xlsx
EXPORT_DIR=exports

AUTO_SYNC_BEFORE_REPORT=false
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_SECONDS=60
REPORT_SYNC_WAIT_SECONDS=240

# Docker/Linux path. The code also auto-detects LibreOffice.
LIBREOFFICE_PATH=/usr/bin/libreoffice

PNG_RENDER_SCALE=4.0
PNG_MAX_WIDTH=6000
